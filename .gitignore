# VisionEdit — Official Git Ignore Configuration
# Hardik Jindal (Roll No. 2024UCA1878) & Ayush Agarwal (Roll No. 2024UCA1822)
# ══════════════════════════════════════════════════════════════════════════════

# ── Python Bytecode & Optimization ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyd

# ── Virtual Environments & Packages ──────────────────────────────────────────
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.eggs
*.egg

# ── Operating System & IDE Specifics ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ── Logs, Caches & Testing Artifacts ─────────────────────────────────────────
*.log
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/
tmp/
.tmp/
scratch/

# ── Large Raw Datasets (Kept on local machine, not pushed to Git) ─────────────
data/DATASET/
datasets/
fiftyone/

# ── Runtime Generated Highlight Outputs (Reproducible via main.py) ───────────
outputs/highlight.mp4
outputs/gradcam/
*.mp4.tmp

# ── Auto-downloaded YOLO Models (Ultralytics caches locally) ──────────────────
yolov8*.pt
yolov9*.pt
yolov10*.pt

# ── Whitelist Key Project Assets & Deliverables ───────────────────────────────
!data/sample_test_video.mp4
!data/README.md
!weights/best_model_weights.h5
!weights/final_model.keras
!weights/saved_model_tf/
!outputs/demos/my_webcam_demo.mp4
!outputs/demos/verified_run.mp4
!outputs/graphs/*.png
!CV_PAPERS/**/*.pdf
