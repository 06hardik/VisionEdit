outputs/highlight.mp4

# Keep CSV/JSON/MD outputs (small, useful for reference)
!outputs/results_table.csv
!outputs/results_table.json
!outputs/results_summary.md
!outputs/literature_crossref.txt
!outputs/real_clip_results.csv
!outputs/metrics_summary.csv
!outputs/architecture_diagram.html
!outputs/presentation.html

# CV_PAPERS PDFs are large — keep the folder tracked but ignore binaries
CV_PAPERS/*.pdf

